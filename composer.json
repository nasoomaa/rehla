{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "rehla/core": "dev-main",
        "rehla/datagrid": "dev-main",
        "rehla/rule": "dev-main",
        "rehla/media": "dev-main",
        "rehla/image-cache": "dev-main",
        "rehla/customers": "dev-main",
        "rehla/admin-users": "dev-main",
        "rehla/catalog": "dev-main",
        "rehla/cart-rule": "dev-main",
        "rehla/sales": "dev-main",
        "rehla/payment": "dev-main",
        "rehla/checkout": "dev-main",
        "rehla/applications": "dev-main",
        "rehla/notifications": "dev-main",
        "rehla/audit-log": "dev-main",
        "rehla/dashboard": "dev-main",
        "rehla/api": "dev-main"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "mrpunyapal/peststan": "^0.2.12",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Rehla\\Core\\": "packages/rehla/core/src/",
            "Rehla\\DataGrid\\": "packages/Rehla/DataGrid/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "format:test": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/rehla/core"
        },
        {
            "type": "path",
            "url": "packages/rehla/datagrid"
        },
        {
            "type": "path",
            "url": "packages/rehla/rule"
        },
        {
            "type": "path",
            "url": "packages/rehla/media"
        },
        {
            "type": "path",
            "url": "packages/rehla/image-cache"
        },
        {
            "type": "path",
            "url": "packages/rehla/customers"
        },
        {
            "type": "path",
            "url": "packages/rehla/admin-users"
        },
        {
            "type": "path",
            "url": "packages/rehla/catalog"
        },
        {
            "type": "path",
            "url": "packages/rehla/cart-rule"
        },
        {
            "type": "path",
            "url": "packages/rehla/sales"
        },
        {
            "type": "path",
            "url": "packages/rehla/payment"
        },
        {
            "type": "path",
            "url": "packages/rehla/checkout"
        },
        {
            "type": "path",
            "url": "packages/rehla/applications"
        },
        {
            "type": "path",
            "url": "packages/rehla/notifications"
        },
        {
            "type": "path",
            "url": "packages/rehla/audit-log"
        },
        {
            "type": "path",
            "url": "packages/rehla/dashboard"
        },
        {
            "type": "path",
            "url": "packages/rehla/api"
        }
    ]
}
