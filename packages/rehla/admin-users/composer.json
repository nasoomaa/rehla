{
    "name": "rehla/admin-users",
    "description": "Rehla Admin Users: admin model, roles, spatie permission bridge, 2FA storage",
    "type": "library",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "rehla/core": "*"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\AdminUsers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\AdminUsers\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}