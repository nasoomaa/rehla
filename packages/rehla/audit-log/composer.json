{
    "name": "rehla/audit-log",
    "description": "Rehla Audit Log: privileged operation auditing, observable failure handling",
    "type": "library",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "rehla/core": "*"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\AuditLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\AuditLog\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}