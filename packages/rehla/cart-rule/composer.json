{
    "name": "rehla/cart-rule",
    "description": "Rehla CartRule: promotions, coupons, discount evaluation via CartRuleContext",
    "type": "library",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "rehla/core": "*",
        "rehla/rule": "*",
        "rehla/catalog": "*",
        "rehla/customers": "*"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\CartRule\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\CartRule\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}