{
    "name": "rehla/catalog",
    "description": "Rehla Catalog: categories, services/products, components, pricing",
    "type": "library",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "rehla/core": "*"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Catalog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Catalog\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}