{
    "name": "rehla/checkout",
    "description": "Rehla Checkout: Cart, totals pipeline, checkout orchestrator, idempotency",
    "type": "library",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "rehla/core": "*",
        "rehla/catalog": "*",
        "rehla/customers": "*",
        "rehla/cart-rule": "*",
        "rehla/sales": "*",
        "rehla/payment": "*"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Checkout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Checkout\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}