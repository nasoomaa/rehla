{
    "name": "rehla/core",
    "description": "Rehla Core: ACL, Menu, SystemConfig, Locale, Currency, shared primitives",
    "type": "library",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Core\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}