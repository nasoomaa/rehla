{
    "name": "rehla/media",
    "description": "Rehla Media: public/private file storage, secure download, MIME validation",
    "type": "library",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "rehla/core": "*"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Media\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}