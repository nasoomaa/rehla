{
    "name": "rehla/notifications",
    "description": "Rehla Notifications: queued dispatch, domain event listeners, retry tracking",
    "type": "library",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "rehla/core": "*"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Notifications\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}