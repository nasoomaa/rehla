{
    "name": "rehla/rule",
    "description": "Rehla Rule engine: conditions, groups, operators, evaluator",
    "type": "library",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "rehla/core": "*"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Rule\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Rule\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}