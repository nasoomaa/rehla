{
    "name": "rehla/sales",
    "description": "Rehla Sales: Order, OrderItem, state machine, status history, cancellation",
    "type": "library",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "rehla/core": "*",
        "rehla/catalog": "*",
        "rehla/customers": "*"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Sales\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Sales\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}